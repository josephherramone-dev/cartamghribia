# systemd service: copy to /etc/systemd/system/cartamghribia.service
[Unit]
Description=Divoxe Games server
After=network.target

[Service]
Type=simple
User=cartamghribia
WorkingDirectory=/opt/cartamghribia
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
